# ============================================================
# UpTen · variables de entorno
# Copia este archivo a ".env.local" para trabajar en tu compu,
# y pega los mismos valores en Vercel > Settings > Environment Variables.
# NUNCA subas ".env.local" ni certificados a GitHub.
# ============================================================

# --- Supabase (Fase 0) ---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon public" key (es segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (SECRETA: da acceso total. Solo en el servidor, jamás en el navegador)
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Dirección pública de tu app (sin "/" al final). En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Correos que son admin (tú), separados por coma
ADMIN_EMAILS=tucorreo@gmail.com
# Texto largo y aleatorio para firmar la sesión de los empleados.
# Genéralo con:  openssl rand -base64 32
SESSION_SECRET=

# --- Apple Wallet (Fase 1 y 2) ---
# Cómo obtener cada una está en el README, sección "Apple Wallet".
# Identificador del pase, ej: pass.com.tuempresa.uptenloyalty
APPLE_PASS_TYPE_ID=
# Team ID de tu cuenta Apple Developer (10 caracteres)
APPLE_TEAM_ID=
# Certificado del Pass Type ID en PEM, codificado en base64
APPLE_PASS_CERT_BASE64=
# Llave privada del certificado en PEM, codificada en base64
APPLE_PASS_KEY_BASE64=
# Contraseña de la llave privada (déjala vacía si no le pusiste)
APPLE_PASS_KEY_PASSPHRASE=
# Certificado WWDR G4 en PEM, codificado en base64
APPLE_WWDR_BASE64=
